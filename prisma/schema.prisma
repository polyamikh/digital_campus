model TaskHistory {
  id          String   @id @default(uuid()) @db.Uuid
  taskId      String   @db.Uuid
  actorId     String   @db.Uuid
  fromState   AssignedTaskState?
  toState     AssignedTaskState
  previousAssigneeId String? @db.Uuid
  nextAssigneeId String? @db.Uuid
  reason      String?  @db.Text
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  task        AssignedTask @relation(fields: [taskId], references: [id], onDelete: Restrict)
  actor       User     @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([taskId, createdAt])
}

model AcademicCalendarEvent {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  kind        CalendarEventKind
  sourceType  String   @db.VarChar(80)
  sourceId    String   @db.Uuid
  startsAt    DateTime @db.Timestamptz(6)
  endsAt      DateTime? @db.Timestamptz(6)
  lessonId    String?  @db.Uuid
  homeworkId  String?  @db.Uuid
  testId      String?  @db.Uuid
  personalTaskId String? @db.Uuid
  assignedTaskId String? @db.Uuid
  lesson      Lesson?  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  homework    Homework? @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  test        Test?    @relation(fields: [testId], references: [id], onDelete: Cascade)
  personalTask PersonalTask? @relation(fields: [personalTaskId], references: [id], onDelete: Cascade)
  assignedTask AssignedTask? @relation(fields: [assignedTaskId], references: [id], onDelete: Cascade)

  // This is a rebuildable, authorized projection, never a source of truth.
  @@unique([userId, sourceType, sourceId])
  @@index([userId, startsAt])
}

model Reminder {
  id          String   @id @default(uuid()) @db.Uuid
