  testId      String?  @db.Uuid
  personalTaskId String? @db.Uuid
  assignedTaskId String? @db.Uuid
  homework    Homework? @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  test        Test?    @relation(fields: [testId], references: [id], onDelete: Cascade)
  personalTask PersonalTask? @relation(fields: [personalTaskId], references: [id], onDelete: Cascade)
  assignedTask AssignedTask? @relation(fields: [assignedTaskId], references: [id], onDelete: Cascade)

  @@unique([sourceType, sourceId, scheduledAt])
  @@index([scheduledAt, sentAt])
}

model AIConversation {
  id          String   @id @default(uuid()) @db.Uuid
  ownerId     String   @db.Uuid
  mode        AIConversationMode?
  title       String?  @db.VarChar(240)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)
  deletedAt   DateTime? @db.Timestamptz(6)
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  messages    AIMessage[]
  attachments AIAttachment[]
  drafts      AIDraft[]
  previews    AIActionPreview[]
  reports     AIReport[]
