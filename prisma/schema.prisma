}

model PersonalTask {
  id          String   @id @default(uuid()) @db.Uuid
  ownerId     String   @db.Uuid
  title       String   @db.VarChar(240)
  details     String?  @db.Text
  dueAt       DateTime? @db.Timestamptz(6)
  endsAt      DateTime? @db.Timestamptz(6)
