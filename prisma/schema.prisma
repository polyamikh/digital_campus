generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// A user's active role is selected at login. Authorization is always checked
// server-side against this assignment and the resource's ownership/scope.
enum Role {
  STUDENT
  TEACHER
  DEAN
}

enum PublicationState {
  DRAFT
  PUBLISHED
  WITHDRAWN
}

enum LessonKind {
  CLASS
  EXAM
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
}

enum ServiceRequestCategory {
  STUDY_CERTIFICATE
  STUDY_PERIOD_CERTIFICATE
  GRADE_TRANSCRIPT
  ACADEMIC_QUESTION
  PERSONAL_DATA_CORRECTION
  OTHER
}

// Legacy broad request kind retained for existing-column compatibility.
enum RequestKind {
  DOCUMENT
  APPEAL
  REQUEST
}

enum LessonState {
  SCHEDULED
  CANCELLED
  COMPLETED
}

enum ScheduleChangeKind {
  RESCHEDULE
  ROOM
  FORMAT
  CANCEL
  SUBSTITUTE
}

enum ScheduleRequestState {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
}

enum ConsentState {
  PENDING
  ACCEPTED
  DECLINED
}

enum AssessmentState {
  DRAFT
  PUBLISHED
  CLOSED
}

enum GradeRevisionState {
  DRAFT
  PUBLISHED
  SUPERSEDED
}

enum HomeworkSubmissionState {
  TO_SUBMIT
  UNDER_REVIEW
  REVISION_REQUIRED
  CHECKED
}

enum TestAttemptState {
  IN_PROGRESS
  SUBMITTED
  REVIEWED
  PUBLISHED
}

enum ServiceRequestState {
  SUBMITTED
  IN_REVIEW
  CLARIFICATION_REQUESTED
  READY_FOR_ISSUE
  COMPLETED
  REJECTED
  CANCELLED
}

enum PassRequestKind {
  TEMPORARY_DEMO_QR
  REPLACEMENT
}

enum PassRequestState {
  SUBMITTED
  IN_REVIEW
  APPROVED
  ISSUED
  REJECTED
  CANCELLED
}

enum NotificationCategory {
  CRITICAL_OFFICIAL
  OFFICIAL_ANNOUNCEMENT
  COURSE_ANNOUNCEMENT
  SCHEDULE
  HOMEWORK
  TEST
  REQUEST
  TASK
  CHAT
  OTHER
}

enum NotificationChannel {
  IN_APP
}

enum CalendarDayKind {
  WORKING
  NON_WORKING
}

enum AssignedTaskState {
  TO_DO
  IN_PROGRESS
  NEEDS_REVISION
  COMPLETED
  CANCELLED
}

enum PersonalTaskState {
  OPEN
  COMPLETED
  CANCELLED
}

enum PersonalTaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum PersonalTaskCategory {
  STUDY
  WORK
  PERSONAL
}

enum CalendarEventKind {
  LESSON
  EXAM
  HOMEWORK_DEADLINE
  TEST_DEADLINE
  PERSONAL_TASK
  ASSIGNED_TASK
}

enum AIMessageRole {
  USER
  ASSISTANT
  TOOL
}

enum AIConversationMode {
  STUDY_PLANNER
  CAREER_ASSISTANT
}

enum ChatKind {
  COURSE
  GROUP
  DIRECT
}

enum CareerOpportunityKind {
  INTERNSHIP
  JOB
  PROJECT
}

enum CareerApplicationState {
  SUBMITTED
  IN_REVIEW
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum CareerEntryKind {
  EXPERIENCE
  PROJECT
}

enum CareerEventState {
  DRAFT
  PUBLISHED
  CANCELLED
}

enum CareerRegistrationState {
  ACTIVE
  CANCELLED
}

enum AIDraftKind {
  STUDY_PLAN
  MATERIAL
  TEST
  RUBRIC_HINT
  REPORT
  ACTION
  OTHER
}

enum AIActionState {
  PREVIEWED
  CONFIRMED
  EXECUTING
  SUCCEEDED
  PARTIALLY_FAILED
  FAILED
  EXPIRED
  CANCELLED
}

enum AIReportState {
  DRAFT
  CONFIRMED
  EXPORTED
  EXPIRED
}

enum CareerOpportunityState {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AuditOutcome {
  SUCCEEDED
  DENIED
  FAILED
}

model User {
  id              String       @id @default(uuid()) @db.Uuid
  login           String       @unique @db.VarChar(190)
  passwordHash    String?      @db.VarChar(255)
  activatedAt     DateTime?    @db.Timestamptz(6)
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime     @updatedAt @db.Timestamptz(6)
  version         Int          @default(1)
  profile         UserProfile?
  studentAcademicProfile StudentAcademicProfile?
  roles           UserRole[]
  sessions        Session[]
  memberships     GroupMembership[]
  teaching        TeacherAssignment[]
  taughtCourses   Course[]     @relation("CourseOwner")
  taughtLessons   Lesson[]     @relation("LessonTeacher")
  examinedLessons Lesson[]     @relation("LessonExaminer")
  substituteFor   Lesson[]     @relation("LessonSubstitute")
  scheduleRequests ScheduleChangeRequest[] @relation("ScheduleRequester")
  scheduleDecisions ScheduleChangeRequest[] @relation("ScheduleDecider")
  proposedSubstitutions ScheduleChangeProposal[] @relation("ProposedSubstitute")
  consents        SubstituteConsent[]
  submissions     Submission[]
  testAttempts    TestAttempt[]
  authoredAssessments Assessment[] @relation("AssessmentAuthor")
  gradeEntries    GradebookEntry[]
  gradeRevisions  GradeRevision[]
  finalGradeClosuresAsStudent FinalGradeClosure[] @relation("FinalGradeStudent")
  finalGradeClosuresAsTeacher FinalGradeClosure[] @relation("FinalGradeTeacher")
  confirmedDebts  ConfirmedAcademicDebt[] @relation("DebtStudent")
  recordedDebts   ConfirmedAcademicDebt[] @relation("DebtRecorder")
  authoredHomework Homework[] @relation("HomeworkAuthor")
  authoredTests   Test[] @relation("TestAuthor")
  authoredMaterials Material[] @relation("MaterialAuthor")
  authoredMaterialFolders MaterialFolder[] @relation("MaterialFolderAuthor")
  reviewedSubmissions SubmissionReview[] @relation("SubmissionReviewer")
  serviceRequests ServiceRequest[] @relation("RequestStudent")
  assignedRequests ServiceRequest[] @relation("RequestAssignee")
  requestHistory  RequestStatusHistory[]
  clarifications  RequestClarification[]
  passRequests    PassRequest[]
  processedPassRequests PassRequest[] @relation("PassRequestProcessor")
  passRequestHistory PassRequestHistory[]
  careerApplicationHistory CareerApplicationHistory[]
  temporaryPasses TemporaryDemoPass[]
  authoredAnnouncements OfficialAnnouncement[] @relation("OfficialAuthor")
  authoredCourseAnnouncements CourseAnnouncement[]
  acknowledgements Acknowledgement[]
  chatMemberships ChatMember[]
  messages        Message[]
  pinnedMessages  Message[] @relation("MessagePinnedBy")
  messageReactions MessageReaction[]
  careerApplications CareerApplication[]
  careerResume CareerResume?
  careerEventRegistrations CareerEventRegistration[]
  notifications   NotificationDelivery[]
  notificationPreferences NotificationPreference[]
  personalTasks   PersonalTask[]
  assignedTasksCreated AssignedTask[] @relation("TaskAssigner")
  assignedTasksOwned AssignedTask[] @relation("TaskAssignee")
  taskHistory     TaskHistory[]
  aiConversations AIConversation[]
  aiActionPreviews AIActionPreview[]
  aiConfirmations AIActionConfirmation[]
  aiReports       AIReport[]
  aiFeedback      AIFeedback[]
  auditEvents     AuditEvent[]
  idempotencyOperations IdempotencyOperation[]
  attendanceRecords AttendanceRecord[] @relation("AttendanceStudent")
  attendanceMarked AttendanceRecord[] @relation("AttendanceMarker")
  assessmentStructuresCreated AssessmentStructureVersion[] @relation("AssessmentStructureAuthor")
  accountActivations AccountActivation[]
  accountActivationsIssued AccountActivation[] @relation("AccountActivationIssuer")
  scheduleStaffReservations ScheduleStaffReservation[]

  @@index([isActive])
}

model UserProfile {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @unique @db.Uuid
  displayName String   @db.VarChar(200)
  email       String?  @db.VarChar(320)
  phone       String?  @db.VarChar(40)
  settings    Json?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)
  version     Int      @default(1)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Individual student identity and academic standing. Program attributes live
// on AcademicProgram and are linked through Group to avoid per-student copies.
model StudentAcademicProfile {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @unique @db.Uuid
  studentNumber  String?  @unique @db.VarChar(80)
  admissionYear  Int?
  academicStatus String?  @db.VarChar(80)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  student        User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([admissionYear])
}

model UserRole {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  role      Role
  grantedAt DateTime @default(now()) @db.Timestamptz(6)
  revokedAt DateTime? @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([role, revokedAt])
}

model Session {
  id          String   @id @default(uuid()) @db.Uuid
  tokenHash   String   @unique @db.VarChar(255)
  userId      String   @db.Uuid
  activeRole  Role
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  expiresAt   DateTime @db.Timestamptz(6)
  revokedAt   DateTime? @db.Timestamptz(6)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([revokedAt, expiresAt])
}

// University-provisioned, single-use activation links. Store only token hashes.
model AccountActivation {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  tokenHash   String   @unique @db.VarChar(255)
  createdById String?  @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  expiresAt   DateTime @db.Timestamptz(6)
  consumedAt  DateTime? @db.Timestamptz(6)
  revokedAt   DateTime? @db.Timestamptz(6)
  user        User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdBy   User?    @relation("AccountActivationIssuer", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([userId, expiresAt])
}

model Group {
  id                String           @id @default(uuid()) @db.Uuid
  code              String           @unique @db.VarChar(40)
  name              String           @db.VarChar(160)
  academicProgramId String?          @db.Uuid
  academicProgram   AcademicProgram? @relation(fields: [academicProgramId], references: [id], onDelete: Restrict)
  memberships       GroupMembership[]
  assignments       TeacherAssignment[]
  courseLinks       CourseGroup[]
  lessons           Lesson[]
  assessments       Assessment[]
  requests          GroupAnnouncementAudience[]
  materialAudiences MaterialAudience[]
  homeworks         Homework[]
  materialFolders   MaterialFolder[]
  chats             Chat[]
  courseAnnouncements CourseAnnouncement[]

  @@index([academicProgramId])
}

// Institute, faculty, direction, program and mode belong to the shared
// educational program, not to each student's profile.
model AcademicProgram {
  id              String  @id @default(uuid()) @db.Uuid
  code            String? @unique @db.VarChar(80)
  name            String? @db.VarChar(200)
  instituteName   String? @db.VarChar(200)
  facultyName     String? @db.VarChar(200)
  directionName   String? @db.VarChar(200)
  studyMode       String? @db.VarChar(80)
  groups          Group[]
}

model GroupMembership {
  id        String   @id @default(uuid()) @db.Uuid
  groupId   String   @db.Uuid
  studentId String   @db.Uuid
  startsAt  DateTime? @db.Timestamptz(6)
  endsAt    DateTime? @db.Timestamptz(6)
  attendanceRecords AttendanceRecord[]
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Restrict)
  student   User     @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@unique([groupId, studentId])
  @@index([studentId, endsAt])
}

model Subject {
  id      String   @id @default(uuid()) @db.Uuid
  code    String?  @unique @db.VarChar(60)
  name    String   @db.VarChar(200)
  courses Course[]
}

model Course {
  id          String   @id @default(uuid()) @db.Uuid
  code        String?  @db.VarChar(80)
  name        String   @db.VarChar(200)
  subjectId   String   @db.Uuid
  ownerId     String   @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  subject     Subject  @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  owner       User     @relation("CourseOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  groups      CourseGroup[]
  assignments TeacherAssignment[]
  lessons     Lesson[]
  components  AssessmentComponent[]
  assessmentStructures AssessmentStructureVersion[]
  assessments Assessment[]
  finalGradeClosures FinalGradeClosure[]
  confirmedDebts ConfirmedAcademicDebt[]
  homework    Homework[]
  tests       Test[]
  materials   Material[]
  materialFolders MaterialFolder[]
  chats       Chat[]
  announcements CourseAnnouncement[]

  @@index([code])
  @@index([ownerId])
  @@index([subjectId])
}

model CourseGroup {
  id             String  @id @default(uuid()) @db.Uuid
  courseId       String  @db.Uuid
  groupId        String  @db.Uuid
  academicYear   String? @db.VarChar(9)
  semesterNumber Int?
  course         Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  group          Group   @relation(fields: [groupId], references: [id], onDelete: Restrict)
  scopedHomeworks Homework[] @relation("HomeworkCourseGroup")
  scopedMaterialFolders MaterialFolder[] @relation("MaterialFolderCourseGroup")

  @@unique([courseId, groupId])
  @@index([groupId])
}

model TeacherAssignment {
  id         String   @id @default(uuid()) @db.Uuid
  teacherId  String   @db.Uuid
  courseId   String   @db.Uuid
  groupId    String   @db.Uuid
  startsAt   DateTime? @db.Timestamptz(6)
  endsAt     DateTime? @db.Timestamptz(6)
  teacher    User     @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  group      Group    @relation(fields: [groupId], references: [id], onDelete: Restrict)

  @@unique([teacherId, courseId, groupId])
  @@index([teacherId, endsAt])
  @@index([courseId, groupId])
}

// One row per calendar year; days and source must come from the official RF
// production calendar. The database intentionally contains no assumed dates.
model ProductionCalendarYear {
  id          String   @id @default(uuid()) @db.Uuid
  year        Int      @unique
  sourceName  String   @db.VarChar(300)
  sourceUrl   String   @db.VarChar(2000)
  sourcePublishedAt DateTime? @db.Timestamptz(6)
  importedAt  DateTime @default(now()) @db.Timestamptz(6)
  verifiedAt  DateTime? @db.Timestamptz(6)
  days        ProductionCalendarDay[]
  requestCalendars ServiceRequestCalendar[]
}

model ProductionCalendarDay {
  id          String   @id @default(uuid()) @db.Uuid
  calendarId  String   @db.Uuid
  date        DateTime @db.Date
  kind        CalendarDayKind
  note        String?  @db.VarChar(300)
  calendar    ProductionCalendarYear @relation(fields: [calendarId], references: [id], onDelete: Cascade)

  @@unique([calendarId, date])
  @@index([date, kind])
}

model AssessmentComponent {
  id          String   @id @default(uuid()) @db.Uuid
  courseId    String   @db.Uuid
  name        String   @db.VarChar(160)
  isRequired  Boolean  @default(false)
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Restrict)
  assessments Assessment[]
  weights     AssessmentWeight[]

  @@unique([courseId, name])
  @@unique([id, courseId])
  @@index([courseId, isRequired])
}

// Immutable published versions pin the point allocation used by assessments.
model AssessmentStructureVersion {
  id          String   @id @default(uuid()) @db.Uuid
  courseId    String   @db.Uuid
  version     Int
  createdById String   @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  publishedAt DateTime? @db.Timestamptz(6)
  reason      String?  @db.Text
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Restrict)
  createdBy   User     @relation("AssessmentStructureAuthor", fields: [createdById], references: [id], onDelete: Restrict)
  weights     AssessmentWeight[]
  assessments Assessment[]

  @@unique([courseId, version])
  @@unique([id, courseId])
  @@index([courseId, publishedAt])
}

model AssessmentWeight {
  id          String   @id @default(uuid()) @db.Uuid
  componentId String   @db.Uuid
  courseId    String   @db.Uuid
  structureVersionId String @db.Uuid
  componentName String @db.VarChar(160)
  // The physical column keeps its legacy name; this is the maximum points
  // allocation in one immutable AssessmentStructureVersion, not a second weight.
  maximumPoints Decimal @map("weight") @db.Decimal(7, 4)
  isRequired  Boolean  @default(false)
  position    Int      @default(0)
  effectiveAt DateTime @default(now()) @db.Timestamptz(6)
  component   AssessmentComponent @relation(fields: [componentId, courseId], references: [id, courseId], onDelete: Restrict)
  structureVersion AssessmentStructureVersion @relation(fields: [structureVersionId, courseId], references: [id, courseId], onDelete: Restrict)
  assessments Assessment[]

  @@unique([structureVersionId, componentId])
  @@unique([structureVersionId, componentId, courseId])
  @@index([componentId, effectiveAt])
  @@index([structureVersionId, position])
}

model Assessment {
  id          String   @id @default(uuid()) @db.Uuid
  courseId    String   @db.Uuid
  groupId     String   @db.Uuid
  componentId String   @db.Uuid
  structureVersionId String @db.Uuid
  authorId    String   @db.Uuid
  title       String   @db.VarChar(240)
  state       AssessmentState @default(DRAFT)
  publishedAt DateTime? @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  version     Int      @default(1)
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Restrict)
  group       Group    @relation(fields: [groupId], references: [id], onDelete: Restrict)
  component   AssessmentComponent @relation(fields: [componentId, courseId], references: [id, courseId], onDelete: Restrict)
  structureVersion AssessmentStructureVersion @relation(fields: [structureVersionId, courseId], references: [id, courseId], onDelete: Restrict)
  componentAllocation AssessmentWeight @relation(fields: [structureVersionId, componentId, courseId], references: [structureVersionId, componentId, courseId], onDelete: Restrict)
  author      User     @relation("AssessmentAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  gradeEntries GradebookEntry[]
  homework    Homework?
  test        Test?

  @@index([courseId, groupId, state])
  @@index([componentId])
  @@index([structureVersionId, componentId])
}

model GradebookEntry {
  id          String   @id @default(uuid()) @db.Uuid
  assessmentId String  @db.Uuid
  studentId   String   @db.Uuid
  currentRevisionId String? @unique @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)
  version     Int      @default(1)
  assessment  Assessment @relation(fields: [assessmentId], references: [id], onDelete: Restrict)
  student     User     @relation(fields: [studentId], references: [id], onDelete: Restrict)
  revisions   GradeRevision[] @relation("EntryRevisions")
  currentRevision GradeRevision? @relation("CurrentGradeRevision", fields: [currentRevisionId, id], references: [id, entryId], onDelete: Restrict)
  retakes     Retake[]

  @@unique([assessmentId, studentId])
  @@unique([currentRevisionId, id])
  @@index([studentId, createdAt])
}

model GradeRevision {
  id          String   @id @default(uuid()) @db.Uuid
  entryId     String   @db.Uuid
  authorId    String   @db.Uuid
  retakeId    String?  @db.Uuid
  score       Decimal  @db.Decimal(5, 2)
  state       GradeRevisionState @default(DRAFT)
  reason      String?  @db.Text
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  publishedAt DateTime? @db.Timestamptz(6)
  entry       GradebookEntry @relation("EntryRevisions", fields: [entryId], references: [id], onDelete: Restrict)
  currentFor  GradebookEntry? @relation("CurrentGradeRevision")
  author      User     @relation(fields: [authorId], references: [id], onDelete: Restrict)
  retake      Retake?  @relation(fields: [retakeId], references: [id], onDelete: SetNull)

  @@index([entryId, state, publishedAt])
  @@unique([id, entryId])
}

model Retake {
  id          String   @id @default(uuid()) @db.Uuid
  entryId     String   @db.Uuid
  attemptNo   Int
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  entry       GradebookEntry @relation(fields: [entryId], references: [id], onDelete: Restrict)
  revisions   GradeRevision[]

  @@unique([entryId, attemptNo])
}

model FinalGradeClosure {
  id          String   @id @default(uuid()) @db.Uuid
  studentId   String   @db.Uuid
  courseId    String   @db.Uuid
  teacherId   String   @db.Uuid
  closedAt    DateTime @default(now()) @db.Timestamptz(6)
  version     Int      @default(1)
  student     User     @relation("FinalGradeStudent", fields: [studentId], references: [id], onDelete: Restrict)
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Restrict)
  teacher     User     @relation("FinalGradeTeacher", fields: [teacherId], references: [id], onDelete: Restrict)

  @@unique([studentId, courseId])
  @@index([courseId, closedAt])
}

model ConfirmedAcademicDebt {
  id          String   @id @default(uuid()) @db.Uuid
  studentId   String   @db.Uuid
  courseId    String   @db.Uuid
  confirmedById String @db.Uuid
  confirmedAt DateTime @default(now()) @db.Timestamptz(6)
  resolvedAt  DateTime? @db.Timestamptz(6)
  reason      String?  @db.Text
  student     User     @relation("DebtStudent", fields: [studentId], references: [id], onDelete: Restrict)
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Restrict)
  confirmedBy User     @relation("DebtRecorder", fields: [confirmedById], references: [id], onDelete: Restrict)

  @@index([studentId, resolvedAt])
  @@index([courseId, confirmedAt])
}

model Homework {
  id          String   @id @default(uuid()) @db.Uuid
  courseId    String   @db.Uuid
  authorId    String   @db.Uuid
  assessmentId String? @unique @db.Uuid
  title       String   @db.VarChar(240)
  instructions String @db.Text
  criteria     String? @db.Text
  groupId      String? @db.Uuid
  allowText    Boolean @default(true)
  allowFile    Boolean @default(false)
  allowLink    Boolean @default(false)
  deadline    DateTime? @db.Timestamptz(6)
  state       PublicationState @default(DRAFT)
  aiPolicy    Json?
  publishedAt DateTime? @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  version     Int      @default(1)
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Restrict)
  group       Group?   @relation(fields: [groupId], references: [id], onDelete: Restrict)
  courseGroup CourseGroup? @relation("HomeworkCourseGroup", fields: [courseId, groupId], references: [courseId, groupId], onDelete: Restrict)
  author      User     @relation("HomeworkAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  assessment  Assessment? @relation(fields: [assessmentId], references: [id], onDelete: SetNull)
  submissions Submission[]
  calendarEvents AcademicCalendarEvent[]
  reminders   Reminder[]
  revisions   PublicationVersion[]
  attachedMaterials HomeworkMaterial[]

  @@index([courseId, state, deadline])
  @@index([authorId, createdAt])
  @@index([groupId, state, deadline])
}

model Submission {
  id          String   @id @default(uuid()) @db.Uuid
  homeworkId  String   @db.Uuid
  studentId   String   @db.Uuid
  state       HomeworkSubmissionState @default(TO_SUBMIT)
  submittedAt DateTime? @db.Timestamptz(6)
  reviewedAt  DateTime? @db.Timestamptz(6)
  feedback    String?  @db.Text
  version     Int      @default(1)
  homework    Homework @relation(fields: [homeworkId], references: [id], onDelete: Restrict)
  student     User     @relation(fields: [studentId], references: [id], onDelete: Restrict)
  revisions   SubmissionRevision[]
  reviews     SubmissionReview[]

  @@unique([homeworkId, studentId])
  @@index([studentId, state])
  @@index([homeworkId, state])
}

model SubmissionRevision {
  id           String   @id @default(uuid()) @db.Uuid
  submissionId String   @db.Uuid
  objectKey    String?  @db.VarChar(1000)
  textContent  String?  @db.Text
  externalUrl  String?  @db.VarChar(2000)
  fileName     String?  @db.VarChar(255)
  mimeType     String?  @db.VarChar(120)
  byteSize     BigInt?
  submittedAt  DateTime? @db.Timestamptz(6)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  reviews      SubmissionReview[]

  @@index([submissionId, createdAt])
  @@unique([id, submissionId])
}

model SubmissionReview {
  id           String   @id @default(uuid()) @db.Uuid
  submissionId String   @db.Uuid
  revisionId   String   @db.Uuid
  reviewerId   String   @db.Uuid
  state        HomeworkSubmissionState
  comment      String?  @db.Text
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  revision     SubmissionRevision @relation(fields: [revisionId, submissionId], references: [id, submissionId], onDelete: Restrict)
  reviewer     User @relation("SubmissionReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)

  @@index([submissionId, createdAt])
}

model Test {
  id          String   @id @default(uuid()) @db.Uuid
  courseId    String   @db.Uuid
  authorId    String   @db.Uuid
  assessmentId String? @unique @db.Uuid
  title       String   @db.VarChar(240)
  externalUrl String?  @db.VarChar(2000)
  opensAt     DateTime? @db.Timestamptz(6)
  closesAt    DateTime? @db.Timestamptz(6)
  attemptLimit Int?
  state       PublicationState @default(DRAFT)
  aiPolicy    Json?
  publishedAt DateTime? @db.Timestamptz(6)
  version     Int      @default(1)
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Restrict)
  author      User     @relation("TestAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  assessment  Assessment? @relation(fields: [assessmentId], references: [id], onDelete: SetNull)
  questions   Question[]
  attempts    TestAttempt[]
  calendarEvents AcademicCalendarEvent[]
  reminders   Reminder[]
  revisions   PublicationVersion[]

  @@index([courseId, state, closesAt])
}

model Question {
  id          String   @id @default(uuid()) @db.Uuid
  testId      String   @db.Uuid
  prompt      String   @db.Text
  kind        String   @db.VarChar(60)
  position    Int
  config      Json
  test        Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  answers     TestAnswer[]

  @@unique([testId, position])
  @@unique([id, testId])
}

model TestAttempt {
  id          String   @id @default(uuid()) @db.Uuid
  testId      String   @db.Uuid
  studentId   String   @db.Uuid
  attemptNo   Int
  state       TestAttemptState @default(IN_PROGRESS)
  startedAt   DateTime @default(now()) @db.Timestamptz(6)
  submittedAt DateTime? @db.Timestamptz(6)
  reviewedAt  DateTime? @db.Timestamptz(6)
  publishedAt DateTime? @db.Timestamptz(6)
  test        Test     @relation(fields: [testId], references: [id], onDelete: Restrict)
  student     User     @relation(fields: [studentId], references: [id], onDelete: Restrict)
  answers     TestAnswer[]

  @@unique([testId, studentId, attemptNo])
  @@unique([id, testId])
  @@index([studentId, state])
}

model TestAnswer {
  id          String   @id @default(uuid()) @db.Uuid
  attemptId   String   @db.Uuid
  questionId  String   @db.Uuid
  testId      String   @db.Uuid
  response    Json
  score       Decimal? @db.Decimal(5, 2)
  reviewedAt  DateTime? @db.Timestamptz(6)
  attempt     TestAttempt @relation(fields: [attemptId, testId], references: [id, testId], onDelete: Restrict)
  question    Question @relation(fields: [questionId, testId], references: [id, testId], onDelete: Restrict)

  @@unique([attemptId, questionId])
}

model Material {
  id          String   @id @default(uuid()) @db.Uuid
  courseId    String   @db.Uuid
  authorId    String   @db.Uuid
  title       String   @db.VarChar(240)
  description String?  @db.Text
  externalUrl String?  @db.VarChar(2000)
  folderId    String?  @db.Uuid
  state       PublicationState @default(DRAFT)
  publishedAt DateTime? @db.Timestamptz(6)
  version     Int      @default(1)
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Restrict)
  author      User     @relation("MaterialAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  versions    PublicationVersion[]
  folder      MaterialFolder? @relation(fields: [folderId], references: [id], onDelete: Restrict)
  audiences   MaterialAudience[]
  files       MaterialFile[]
  attachedToHomework HomeworkMaterial[]

  @@index([courseId, state])
  @@index([authorId])
  @@index([folderId, state])
}

model MaterialFolder {
  id        String   @id @default(uuid()) @db.Uuid
  courseId  String   @db.Uuid
  groupId   String   @db.Uuid
  authorId  String   @db.Uuid
  name      String   @db.VarChar(160)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Restrict)
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Restrict)
  courseGroup CourseGroup @relation("MaterialFolderCourseGroup", fields: [courseId, groupId], references: [courseId, groupId], onDelete: Restrict)
  author    User     @relation("MaterialFolderAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  materials Material[]

  @@unique([courseId, groupId, name])
  @@index([authorId, courseId, groupId])
}

model MaterialAudience {
  materialId String @db.Uuid
  groupId    String @db.Uuid
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  group      Group @relation(fields: [groupId], references: [id], onDelete: Restrict)

  @@id([materialId, groupId])
  @@index([groupId, materialId])
}

model MaterialFile {
  id          String   @id @default(uuid()) @db.Uuid
  materialId  String   @db.Uuid
  objectKey   String   @unique @db.VarChar(1000)
  fileName    String   @db.VarChar(255)
  mimeType    String   @db.VarChar(120)
  byteSize    BigInt
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  material    Material @relation(fields: [materialId], references: [id], onDelete: Restrict)

  @@index([materialId, createdAt])
}

model HomeworkMaterial {
  homeworkId String @db.Uuid
  materialId String @db.Uuid
  homework   Homework @relation(fields: [homeworkId], references: [id], onDelete: Restrict)
  material   Material @relation(fields: [materialId], references: [id], onDelete: Restrict)

  @@id([homeworkId, materialId])
  @@index([materialId, homeworkId])
}

// A version may belong to one publishable object. Enforce exactly one owner
// with a PostgreSQL CHECK constraint in a reviewed migration.
model PublicationVersion {
  id          String   @id @default(uuid()) @db.Uuid
  materialId  String?  @db.Uuid
  homeworkId  String?  @db.Uuid
  testId      String?  @db.Uuid
  number      Int
  state       PublicationState
  content     Json
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  publishedAt DateTime? @db.Timestamptz(6)
  material    Material? @relation(fields: [materialId], references: [id], onDelete: Restrict)
  homework    Homework? @relation(fields: [homeworkId], references: [id], onDelete: Restrict)
  test        Test?     @relation(fields: [testId], references: [id], onDelete: Restrict)

  @@unique([materialId, number])
  @@unique([homeworkId, number])
  @@unique([testId, number])
}

model Room {
  id       String   @id @default(uuid()) @db.Uuid
  code     String   @unique @db.VarChar(80)
  name     String?  @db.VarChar(160)
  lessons  Lesson[]
  proposals ScheduleChangeProposal[]
}

model Lesson {
  id          String   @id @default(uuid()) @db.Uuid
  courseId    String   @db.Uuid
  groupId     String   @db.Uuid
  teacherId   String?  @db.Uuid
  examinerId  String?  @db.Uuid
  substituteId String? @db.Uuid
  roomId      String?  @db.Uuid
  title       String   @db.VarChar(240)
  format      String?  @db.VarChar(100)
  kind        LessonKind @default(CLASS)
  startsAt    DateTime @db.Timestamptz(6)
  endsAt      DateTime @db.Timestamptz(6)
  state       LessonState @default(SCHEDULED)
  version     Int      @default(1)
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Restrict)
  group       Group    @relation(fields: [groupId], references: [id], onDelete: Restrict)
  teacher     User?    @relation("LessonTeacher", fields: [teacherId], references: [id], onDelete: Restrict)
  examiner    User?    @relation("LessonExaminer", fields: [examinerId], references: [id], onDelete: Restrict)
  substitute  User?    @relation("LessonSubstitute", fields: [substituteId], references: [id], onDelete: Restrict)
  room        Room?    @relation(fields: [roomId], references: [id], onDelete: Restrict)
  versions    LessonScheduleVersion[]
  changeRequests ScheduleChangeRequest[]
  calendarEvents AcademicCalendarEvent[]
  attendanceRecords AttendanceRecord[]
  staffReservations ScheduleStaffReservation[]

  @@unique([id, groupId])
  @@index([groupId, startsAt, state])
  @@index([teacherId, startsAt, state])
  @@index([examinerId, startsAt, state])
  @@index([roomId, startsAt, state])
}

model AttendanceRecord {
  id         String   @id @default(uuid()) @db.Uuid
  lessonId   String   @db.Uuid
  groupId    String   @db.Uuid
  studentId  String   @db.Uuid
  status     AttendanceStatus
  markedById String   @db.Uuid
  markedAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @db.Timestamptz(6)
  version    Int      @default(1)
  lesson     Lesson   @relation(fields: [lessonId, groupId], references: [id, groupId], onDelete: Restrict)
  membership GroupMembership @relation(fields: [groupId, studentId], references: [groupId, studentId], onDelete: Restrict)
  student    User     @relation("AttendanceStudent", fields: [studentId], references: [id], onDelete: Restrict)
  markedBy   User     @relation("AttendanceMarker", fields: [markedById], references: [id], onDelete: Restrict)

  @@unique([lessonId, studentId])
  @@index([lessonId, status])
  @@index([studentId, markedAt])
}

// Integrity projection for all teaching staff occupied by a scheduled slot.
// Lesson remains the canonical event; PostgreSQL exclusion protects overlaps
// between a lesson teacher, an exam examiner, and other scheduled events.
model ScheduleStaffReservation {
  id        String   @id @default(uuid()) @db.Uuid
  lessonId  String   @db.Uuid
  staffId   String   @db.Uuid
  startsAt  DateTime @db.Timestamptz(6)
  endsAt    DateTime @db.Timestamptz(6)
  isActive  Boolean  @default(true)
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  staff     User     @relation(fields: [staffId], references: [id], onDelete: Restrict)

  @@unique([lessonId, staffId])
  @@index([staffId, startsAt])
}

model LessonScheduleVersion {
  id          String   @id @default(uuid()) @db.Uuid
  lessonId    String   @db.Uuid
  version     Int
  snapshot    Json
  changedAt   DateTime @default(now()) @db.Timestamptz(6)
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Restrict)

  @@unique([lessonId, version])
  @@index([changedAt])
}

model ScheduleChangeRequest {
  id          String   @id @default(uuid()) @db.Uuid
  lessonId    String   @db.Uuid
  requesterId String   @db.Uuid
  baseVersion Int
  kind        ScheduleChangeKind
  state       ScheduleRequestState @default(PENDING)
  reason      String?  @db.Text
  submittedAt DateTime @default(now()) @db.Timestamptz(6)
  decidedAt   DateTime? @db.Timestamptz(6)
  decidedById String?  @db.Uuid
  approvedProposalId String? @db.Uuid
  decisionReason String? @db.Text
  version     Int      @default(1)
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Restrict)
  requester   User     @relation("ScheduleRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  decidedBy   User?    @relation("ScheduleDecider", fields: [decidedById], references: [id], onDelete: Restrict)
  proposals   ScheduleChangeProposal[]
  approvedProposal ScheduleChangeProposal? @relation("ApprovedScheduleProposal", fields: [approvedProposalId, id], references: [id, requestId], onDelete: Restrict)
  consents    SubstituteConsent[]

  @@unique([approvedProposalId, id])
  @@index([state, submittedAt])
  @@index([lessonId, baseVersion])
  @@index([requesterId, state])
}

model ScheduleChangeProposal {
  id          String   @id @default(uuid()) @db.Uuid
  requestId   String   @db.Uuid
  startsAt    DateTime? @db.Timestamptz(6)
  endsAt      DateTime? @db.Timestamptz(6)
  roomId      String?  @db.Uuid
  format      String?  @db.VarChar(100)
  substituteId String? @db.Uuid
  cancelled   Boolean?
  request     ScheduleChangeRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  room        Room?    @relation(fields: [roomId], references: [id], onDelete: Restrict)
  substitute User?    @relation("ProposedSubstitute", fields: [substituteId], references: [id], onDelete: Restrict)
  consents   SubstituteConsent[]
  approvedByRequest ScheduleChangeRequest? @relation("ApprovedScheduleProposal")

  @@index([requestId])
  @@unique([id, requestId])
  @@unique([id, requestId, substituteId])
}

model SubstituteConsent {
  id          String   @id @default(uuid()) @db.Uuid
  requestId   String   @db.Uuid
  proposalId  String   @db.Uuid
  teacherId   String   @db.Uuid
  state       ConsentState @default(PENDING)
  respondedAt DateTime? @db.Timestamptz(6)
  request     ScheduleChangeRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  proposal    ScheduleChangeProposal @relation(fields: [proposalId, requestId, teacherId], references: [id, requestId, substituteId], onDelete: Restrict)
  teacher     User     @relation(fields: [teacherId], references: [id], onDelete: Restrict)

  @@unique([requestId, teacherId])
}

model ServiceRequest {
  id          String   @id @default(uuid()) @db.Uuid
  studentId   String   @db.Uuid
  assignedToId String? @db.Uuid
  // Legacy broad classification is retained for compatibility; category is authoritative.
  kind        RequestKind?
  category    ServiceRequestCategory
  state       ServiceRequestState @default(SUBMITTED)
  title       String   @db.VarChar(240)
  body        String   @db.Text
  priority    Int      @default(0)
  submittedAt DateTime @default(now()) @db.Timestamptz(6)
  slaWorkingDays Int
  deadlineAt  DateTime? @db.Timestamptz(6)
  completedAt DateTime? @db.Timestamptz(6)
  rejectionReason String? @db.Text
  version     Int      @default(1)
  student     User     @relation("RequestStudent", fields: [studentId], references: [id], onDelete: Restrict)
  assignedTo  User?    @relation("RequestAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  slaCalendars ServiceRequestCalendar[]
  history     RequestStatusHistory[]
  clarifications RequestClarification[]
  documents   DocumentArtifact[]
  escalations Escalation[]

  @@index([studentId, submittedAt])
  @@index([state, deadlineAt])
  @@index([assignedToId, state, deadlineAt])
  @@index([category, state, deadlineAt])
}

// A request near New Year can depend on official calendar data for two years.
model ServiceRequestCalendar {
  id          String   @id @default(uuid()) @db.Uuid
  requestId   String   @db.Uuid
  calendarId  String   @db.Uuid
  request     ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  calendar    ProductionCalendarYear @relation(fields: [calendarId], references: [id], onDelete: Restrict)

  @@unique([requestId, calendarId])
  @@index([calendarId, requestId])
}

model RequestStatusHistory {
  id          String   @id @default(uuid()) @db.Uuid
  requestId   String   @db.Uuid
  actorId     String   @db.Uuid
  fromState   ServiceRequestState?
  toState     ServiceRequestState
  reason      String?  @db.Text
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  request     ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  actor       User     @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([requestId, createdAt])
}

model RequestClarification {
  id          String   @id @default(uuid()) @db.Uuid
  requestId   String   @db.Uuid
  requestedById String @db.Uuid
  question    String   @db.Text
  answer      String?  @db.Text
  requestedAt DateTime @default(now()) @db.Timestamptz(6)
  answeredAt  DateTime? @db.Timestamptz(6)
  request     ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  requestedBy User    @relation(fields: [requestedById], references: [id], onDelete: Restrict)

  @@index([requestId, requestedAt])
}

model DocumentArtifact {
  id          String   @id @default(uuid()) @db.Uuid
  requestId   String   @db.Uuid
  objectKey   String   @unique @db.VarChar(1000)
  fileName    String   @db.VarChar(255)
  mimeType    String   @db.VarChar(150)
  byteSize    BigInt
  issuedAt    DateTime? @db.Timestamptz(6)
  revokedAt   DateTime? @db.Timestamptz(6)
  request     ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)

  @@index([requestId, issuedAt])
}

model Escalation {
  id          String   @id @default(uuid()) @db.Uuid
  requestId   String   @db.Uuid
  episodeStartedAt DateTime @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  closedAt    DateTime? @db.Timestamptz(6)
  request     ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)

  @@unique([requestId, episodeStartedAt])
  @@index([closedAt, createdAt])
}

model PassRequest {
  id          String   @id @default(uuid()) @db.Uuid
  studentId   String   @db.Uuid
  kind        PassRequestKind
  state       PassRequestState @default(SUBMITTED)
  submittedAt DateTime @default(now()) @db.Timestamptz(6)
  issuedAt    DateTime? @db.Timestamptz(6)
  processedById String? @db.Uuid
  decisionReason String? @db.Text
  version     Int      @default(1)
  student     User     @relation(fields: [studentId], references: [id], onDelete: Restrict)
  processedBy User?    @relation("PassRequestProcessor", fields: [processedById], references: [id], onDelete: SetNull)
  history     PassRequestHistory[]
  temporaryPass TemporaryDemoPass?

  @@unique([id, studentId])
  @@index([studentId, state, submittedAt])
  @@index([state, submittedAt])
}

model PassRequestHistory {
  id          String   @id @default(uuid()) @db.Uuid
  requestId   String   @db.Uuid
  actorId     String   @db.Uuid
  fromState   PassRequestState?
  toState     PassRequestState
  note        String?  @db.Text
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  request     PassRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  actor       User     @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([requestId, createdAt])
}

// One temporary demo pass may be issued per student and Moscow calendar day.
// validDate is calculated by server logic from the issuance time in Europe/Moscow;
// expiry or revocation does not permit another issuance for that day.
model TemporaryDemoPass {
  id          String   @id @default(uuid()) @db.Uuid
  requestId   String   @unique @db.Uuid
  studentId   String   @db.Uuid
  validDate   DateTime @db.Date
  tokenHash   String   @unique @db.VarChar(255)
  issuedAt    DateTime @default(now()) @db.Timestamptz(6)
  expiresAt   DateTime @db.Timestamptz(6)
  revokedAt   DateTime? @db.Timestamptz(6)
  request     PassRequest @relation(fields: [requestId, studentId], references: [id, studentId], onDelete: Restrict)
  student     User     @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@unique([studentId, validDate])
  @@unique([requestId, studentId])
  @@index([studentId, validDate, revokedAt, expiresAt])
}

model OfficialAnnouncement {
  id          String   @id @default(uuid()) @db.Uuid
  authorId    String   @db.Uuid
  state       PublicationState @default(DRAFT)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  withdrawnAt DateTime? @db.Timestamptz(6)
  version     Int      @default(1)
  author      User     @relation("OfficialAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  versions    AnnouncementVersion[]
  roleAudiences RoleAnnouncementAudience[]
  groupAudiences GroupAnnouncementAudience[]
  acknowledgements Acknowledgement[]

  @@index([state, createdAt])
}

model AnnouncementVersion {
  id              String   @id @default(uuid()) @db.Uuid
  announcementId  String   @db.Uuid
  number          Int
  title           String   @db.VarChar(240)
  body            String   @db.Text
  requiresAcknowledgement Boolean @default(false)
  publishedAt     DateTime? @db.Timestamptz(6)
  announcement    OfficialAnnouncement @relation(fields: [announcementId], references: [id], onDelete: Restrict)
  acknowledgements Acknowledgement[]

  @@unique([announcementId, number])
  @@unique([id, announcementId])
  @@index([publishedAt])
  @@index([publishedAt, requiresAcknowledgement])
}

model RoleAnnouncementAudience {
  id             String   @id @default(uuid()) @db.Uuid
  announcementId String   @db.Uuid
  role           Role
  announcement   OfficialAnnouncement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@unique([announcementId, role])
}

model GroupAnnouncementAudience {
  id             String   @id @default(uuid()) @db.Uuid
  announcementId String   @db.Uuid
  groupId        String   @db.Uuid
  announcement   OfficialAnnouncement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  group          Group    @relation(fields: [groupId], references: [id], onDelete: Restrict)

  @@unique([announcementId, groupId])
}

model Acknowledgement {
  id              String   @id @default(uuid()) @db.Uuid
  announcementId  String   @db.Uuid
  versionId       String   @db.Uuid
  userId          String   @db.Uuid
  acknowledgedAt  DateTime @default(now()) @db.Timestamptz(6)
  announcement    OfficialAnnouncement @relation(fields: [announcementId], references: [id], onDelete: Restrict)
  version         AnnouncementVersion @relation(fields: [versionId, announcementId], references: [id, announcementId], onDelete: Restrict)
  user            User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([versionId, userId])
  @@index([announcementId, userId])
}

model CourseAnnouncement {
  id          String   @id @default(uuid()) @db.Uuid
  courseId    String   @db.Uuid
  groupId     String?  @db.Uuid
  authorId    String   @db.Uuid
  title       String   @db.VarChar(240)
  body        String   @db.Text
  publishedAt DateTime @default(now()) @db.Timestamptz(6)
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Restrict)
  group       Group?   @relation(fields: [groupId], references: [id], onDelete: Restrict)
  author      User     @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([courseId, publishedAt])
  @@index([groupId, publishedAt])
}

model Chat {
  id        String   @id @default(uuid()) @db.Uuid
  courseId  String?  @db.Uuid
  groupId   String?  @db.Uuid
  kind      ChatKind @default(COURSE)
  directKey String?  @unique @db.VarChar(80)
  name      String?  @db.VarChar(200)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  course    Course?  @relation(fields: [courseId], references: [id], onDelete: Restrict)
  group     Group?   @relation(fields: [groupId], references: [id], onDelete: Restrict)
  members   ChatMember[]
  messages  Message[]

  @@index([courseId, kind])
  @@index([groupId, kind])
}

model ChatMember {
  id       String   @id @default(uuid()) @db.Uuid
  chatId   String   @db.Uuid
  userId   String   @db.Uuid
  joinedAt DateTime @default(now()) @db.Timestamptz(6)
  leftAt   DateTime? @db.Timestamptz(6)
  lastReadAt DateTime? @db.Timestamptz(6)
  mutedAt  DateTime? @db.Timestamptz(6)
  chat     Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([chatId, userId])
  @@index([userId, leftAt])
}

model Message {
  id        String   @id @default(uuid()) @db.Uuid
  chatId    String   @db.Uuid
  senderId  String   @db.Uuid
  body      String   @db.Text
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  replyToId String?  @db.Uuid
  pinnedAt  DateTime? @db.Timestamptz(6)
  pinnedById String? @db.Uuid
  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Restrict)
  replyTo   Message? @relation("MessageReplies", fields: [replyToId, chatId], references: [id, chatId], onDelete: Restrict)
  replies   Message[] @relation("MessageReplies")
  pinnedBy  User?    @relation("MessagePinnedBy", fields: [pinnedById], references: [id], onDelete: SetNull)
  reactions MessageReaction[]
  attachments MessageAttachment[]

  @@index([chatId, createdAt])
  @@unique([id, chatId])
  @@index([replyToId, chatId])
}

model MessageReaction {
  messageId String @db.Uuid
  userId    String @db.Uuid
  reaction  String @db.VarChar(32)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId, reaction])
  @@index([userId, createdAt])
}

model MessageAttachment {
  id        String @id @default(uuid()) @db.Uuid
  messageId String @db.Uuid
  objectKey String @unique @db.VarChar(1000)
  fileName  String @db.VarChar(255)
  mimeType  String @db.VarChar(120)
  byteSize  BigInt
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  message   Message @relation(fields: [messageId], references: [id], onDelete: Restrict)

  @@index([messageId, createdAt])
}

model Notification {
