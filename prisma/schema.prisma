  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  revokedAt      DateTime? @db.Timestamptz(6)
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, revokedAt])
}

model AIDraft {
  id             String   @id @default(uuid()) @db.Uuid
  conversationId String   @db.Uuid
  kind           AIDraftKind
  content        Json
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  deletedAt      DateTime? @db.Timestamptz(6)
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model AIContextReference {
  id             String   @id @default(uuid()) @db.Uuid
  conversationId String   @db.Uuid
  sourceType     String   @db.VarChar(80)
  sourceId       String   @db.Uuid
  sourceVersion  Int?
  checkedAt      DateTime @default(now()) @db.Timestamptz(6)
  staleAt        DateTime? @db.Timestamptz(6)
  allowed        Boolean
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, checkedAt])
  @@index([sourceType, sourceId])
}

model AIActionPreview {
  id             String   @id @default(uuid()) @db.Uuid
  conversationId String   @db.Uuid
  actorId        String   @db.Uuid
  actionType     String   @db.VarChar(120)
  proposal       Json
  baseVersions   Json
  state          AIActionState @default(PREVIEWED)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  expiresAt      DateTime @db.Timestamptz(6)
  conversation   AIConversation @relation(fields: [conversationId, actorId], references: [id, ownerId], onDelete: Restrict)
  actor          User     @relation(fields: [actorId], references: [id], onDelete: Restrict)
  confirmations  AIActionConfirmation[]

  @@index([actorId, state, expiresAt])
  @@unique([id, actorId])
}

model AIActionConfirmation {
  id             String   @id @default(uuid()) @db.Uuid
  previewId      String   @db.Uuid
  confirmedById  String   @db.Uuid
  confirmedAt    DateTime @default(now()) @db.Timestamptz(6)
  operationId    String   @unique @db.Uuid
  confirmedBy    User     @relation(fields: [confirmedById], references: [id], onDelete: Restrict)
  preview        AIActionPreview @relation(fields: [previewId, confirmedById], references: [id, actorId], onDelete: Restrict)
  operation      IdempotencyOperation @relation(fields: [operationId, confirmedById], references: [id, actorId], onDelete: Restrict)

  @@unique([previewId])
  @@unique([operationId, confirmedById])
}

model AIReport {
  id          String   @id @default(uuid()) @db.Uuid
  conversationId String @db.Uuid
  ownerId     String   @db.Uuid
  state       AIReportState @default(DRAFT)
  title       String   @db.VarChar(240)
  content     Json
  sources     Json
  periodStart DateTime? @db.Timestamptz(6)
  periodEnd   DateTime? @db.Timestamptz(6)
  sampleSize  Int?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  expiresAt   DateTime @db.Timestamptz(6)
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  conversation AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([ownerId, state, expiresAt])
}

model AIFeedback {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  messageId   String   @db.Uuid
  rating      Int?
  comment     String?  @db.Text
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message     AIMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([userId, messageId])
  @@index([createdAt])
}

model AIUsage {
  id             String   @id @default(uuid()) @db.Uuid
  conversationId String   @db.Uuid
  model          String   @db.VarChar(160)
  inputTokens    Int      @default(0)
  outputTokens   Int      @default(0)
  estimatedCost  Decimal? @db.Decimal(14, 6)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([createdAt, model])
  @@index([conversationId, createdAt])
}

model CareerCategory {
  id            String   @id @default(uuid()) @db.Uuid
  name          String   @unique @db.VarChar(160)
  opportunities CareerOpportunity[]
}

model CareerOpportunity {
  id          String   @id @default(uuid()) @db.Uuid
  categoryId  String   @db.Uuid
  title       String   @db.VarChar(240)
  organization String @db.VarChar(240)
  description String   @db.Text
  location    String?  @db.VarChar(200)
  kind        CareerOpportunityKind?
  direction   String?  @db.VarChar(160)
  externalUrl String?  @db.VarChar(2000)
  closesAt    DateTime? @db.Timestamptz(6)
  isDemo      Boolean  @default(true)
  state       CareerOpportunityState @default(DRAFT)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  category    CareerCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  applications CareerApplication[]

  @@index([categoryId, state, closesAt])
  @@index([kind, state, closesAt])
}

model CareerApplication {
  id             String @id @default(uuid()) @db.Uuid
  studentId      String @db.Uuid
  opportunityId  String @db.Uuid
  state          CareerApplicationState @default(SUBMITTED)
  coverLetter    String? @db.Text
  appliedAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)
  student        User @relation(fields: [studentId], references: [id], onDelete: Restrict)
  opportunity    CareerOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Restrict)
  history        CareerApplicationHistory[]

  @@unique([studentId, opportunityId])
  @@index([studentId, state, appliedAt])
  @@index([opportunityId, state, appliedAt])
}

model CareerApplicationHistory {
  id            String @id @default(uuid()) @db.Uuid
  applicationId String @db.Uuid
  actorId       String @db.Uuid
  fromState     CareerApplicationState?
  toState       CareerApplicationState
  note          String? @db.Text
  createdAt     DateTime @default(now()) @db.Timestamptz(6)
  application   CareerApplication @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  actor         User @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([applicationId, createdAt])
}

model CareerResume {
  id        String @id @default(uuid()) @db.Uuid
  studentId String @unique @db.Uuid
  headline  String? @db.VarChar(200)
  summary   String? @db.Text
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  student   User @relation(fields: [studentId], references: [id], onDelete: Restrict)
  skills    CareerResumeSkill[]
  entries   CareerResumeEntry[]
}

model CareerResumeSkill {
  id       String @id @default(uuid()) @db.Uuid
  resumeId String @db.Uuid
  name     String @db.VarChar(100)
  level    String? @db.VarChar(40)
  resume   CareerResume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@unique([resumeId, name])
  @@index([resumeId, name])
}

model CareerResumeEntry {
  id          String @id @default(uuid()) @db.Uuid
  resumeId    String @db.Uuid
  kind        CareerEntryKind
  title       String @db.VarChar(200)
  organization String? @db.VarChar(200)
  description String? @db.Text
  startedAt   DateTime? @db.Date
  endedAt     DateTime? @db.Date
  externalUrl String? @db.VarChar(2000)
  position    Int @default(0)
  resume      CareerResume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId, kind, position])
}

model CareerEvent {
  id          String @id @default(uuid()) @db.Uuid
  title       String @db.VarChar(240)
  description String @db.Text
  startsAt    DateTime @db.Timestamptz(6)
  endsAt      DateTime? @db.Timestamptz(6)
  location    String? @db.VarChar(200)
  externalUrl String? @db.VarChar(2000)
  isDemo      Boolean @default(true)
  state       CareerEventState @default(DRAFT)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  registrations CareerEventRegistration[]

  @@index([state, startsAt])
}

model CareerEventRegistration {
  id        String @id @default(uuid()) @db.Uuid
  eventId   String @db.Uuid
  studentId String @db.Uuid
  state     CareerRegistrationState @default(ACTIVE)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  event     CareerEvent @relation(fields: [eventId], references: [id], onDelete: Restrict)
  student   User @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@unique([eventId, studentId])
  @@index([studentId, state, createdAt])
}

model AuditEvent {
  id          String   @id @default(uuid()) @db.Uuid
  actorId     String?  @db.Uuid
  action      String   @db.VarChar(120)
  targetType  String   @db.VarChar(100)
  targetId    String?  @db.Uuid
  outcome     AuditOutcome
  reason      String?  @db.Text
  metadata    Json?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  actor       User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  // Never put credentials, private document contents or AI prompt/response
  // bodies into metadata. targetType/targetId is intentionally polymorphic.
  @@index([actorId, createdAt])
  @@index([targetType, targetId, createdAt])
  @@index([action, createdAt])
}

model IdempotencyOperation {
  id          String   @id @default(uuid()) @db.Uuid
  actorId     String   @db.Uuid
  operationKey String  @db.VarChar(240)
  operationType String @db.VarChar(120)
  requestHash String   @db.VarChar(128)
  resultRefType String? @db.VarChar(100)
  resultRefId String?  @db.Uuid
  result      Json?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  completedAt DateTime? @db.Timestamptz(6)
  actor       User     @relation(fields: [actorId], references: [id], onDelete: Restrict)
  aiConfirmation AIActionConfirmation?

  @@unique([actorId, operationKey])
  @@unique([id, actorId])
  @@index([operationType, createdAt])
}

model RecordVersion {
  id          String   @id @default(uuid()) @db.Uuid
  entityType  String   @db.VarChar(100)
  entityId    String   @db.Uuid
  version     Int
  snapshot    Json
  changedAt   DateTime @default(now()) @db.Timestamptz(6)
  changedById String?  @db.Uuid

  // Domain tables retain a version column for compare-and-swap. This record
  // stores only the snapshots needed for conflict comparison and audit.
  @@unique([entityType, entityId, version])
  @@index([entityType, entityId, changedAt])
}
